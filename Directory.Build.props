<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>NU1901;NU1902;NU1903;NU1608</WarningsNotAsErrors>
    <RootNamespace>$(MSBuildProjectName)</RootNamespace>
    <!-- Set with -p:EzScVersion=...; a global -p:Version would also re-version the referenced ez-odata projects -->
    <EzScVersion Condition="'$(EzScVersion)' == ''">0.1.0-poc</EzScVersion>
    <Version>$(EzScVersion)</Version>
    <Authors>Noctusoft, Inc.</Authors>
    <Company>Noctusoft, Inc.</Company>
    <Copyright>Copyright © 2026 Noctusoft, Inc.</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/YOLOVibeCode/ez-odata-api.Dapper.SimpleCRUD</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/YOLOVibeCode/ez-odata-api.Dapper.SimpleCRUD</PackageProjectUrl>
    <PackageTags>dapper;simplecrud;odata;rest;ez-odata;multi-database;dialect</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsPackable>false</IsPackable>

    <!--
      Where ez-odata-api comes from. Default: the sibling checkout, referenced read-only
      (nothing in it is modified). Set EzOdataSource=package to consume the published
      EzOdata.* packages from GitHub Packages instead.
    -->
    <EzOdataSource Condition="'$(EzOdataSource)' == ''">project</EzOdataSource>
    <EzOdataRoot Condition="'$(EzOdataRoot)' == ''">$(MSBuildThisFileDirectory)..\ez-odata-api\</EzOdataRoot>
    <EzOdataVersion Condition="'$(EzOdataVersion)' == ''">1.0.4</EzOdataVersion>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="PolySharp" Version="1.15.0" PrivateAssets="all" />
  </ItemGroup>

</Project>
