<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>NU1901;NU1902;NU1903;NU1608</WarningsNotAsErrors>
    <RootNamespace>$(MSBuildProjectName)</RootNamespace>
    <!-- Set with -p:EzScVersion=...; a global -p:Version would also re-version the referenced ez-odata projects -->
    <EzScVersion Condition="'$(EzScVersion)' == ''">1.0.1</EzScVersion>
    <Version>$(EzScVersion)</Version>
    <Authors>Noctusoft, Inc.</Authors>
    <Company>Noctusoft, Inc.</Company>
    <Copyright>Copyright © 2026 Noctusoft, Inc.</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/YOLOVibeCode/ez-odata-api.Dapper.SimpleCRUD</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/YOLOVibeCode/ez-odata-api.Dapper.SimpleCRUD</PackageProjectUrl>
    <PackageTags>dapper;simplecrud;odata;rest;ez-odata;multi-database;dialect</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsPackable>false</IsPackable>

    <!--
      Where ez-odata-api comes from. Default: the published EzOdata.* packages on nuget.org.
      For side-by-side development against a checkout, build with -p:EzOdataSource=project
      (and -p:EzOdataRoot=path/to/ez-odata-api/ if it is not a sibling folder).
    -->
    <EzOdataSource Condition="'$(EzOdataSource)' == ''">package</EzOdataSource>
    <EzOdataRoot Condition="'$(EzOdataRoot)' == ''">$(MSBuildThisFileDirectory)..\ez-odata-api\</EzOdataRoot>
    <EzOdataVersion Condition="'$(EzOdataVersion)' == ''">1.0.6</EzOdataVersion>

    <!-- Minimum Dapper.SimpleCRUD the packages depend on; CI also tests newer releases (-p:SimpleCrudVersion=...). -->
    <SimpleCrudVersion Condition="'$(SimpleCrudVersion)' == ''">2.3.0</SimpleCrudVersion>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)docs/nuget/README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="PolySharp" Version="1.15.0" PrivateAssets="all" />
  </ItemGroup>

</Project>
